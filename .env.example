# .env.example — copy to .env and fill in for local development.
# Never commit .env. Real secrets go in your deployment platform's secret store.
#
# Variables here override the defaults in config.ini.

# --- Logging ------------------------------------------------------------------
# Overrides [logging].level in config.ini. One of DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# --- Ollama (LLM backend) -----------------------------------------------------
# Inside docker-compose, point at the ollama service container.
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b

# --- Keycloak (admin bootstrap, local only) -----------------------------------
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=change-this-admin-password
KC_HOSTNAME=http://YOUR_SERVER_IP:8081

# --- Keycloak database --------------------------------------------------------
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=change-this-db-password

# --- Keycloak app config ------------------------------------------------------
# URL the API uses to reach Keycloak from inside the docker network.
KEYCLOAK_URL=http://keycloak:8080
# URL the browser uses to reach Keycloak from outside the docker network.
# This is what Swagger UI redirects to for login.
KEYCLOAK_PUBLIC_URL=http://YOUR_SERVER_IP:8081
KEYCLOAK_REALM=proposal
KEYCLOAK_CLIENT_ID=proposal-api

# --- GitHub OAuth (referenced by Keycloak realm import) -----------------------
# Used by Keycloak's GitHub identity provider, not directly by the API.
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# --- Microsoft Graph / Planner integration ------------------------------------
# Required only for the /proposal/planner endpoint. Leave empty if unused.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=


GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxx
GITHUB_OWNER=your-user
GITHUB_REPO=proposal-sandbox
GITHUB_API_URL=https://api.github.com

